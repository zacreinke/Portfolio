---
/**
 * Local curation board. Not part of the portfolio: this file sits outside
 * src/pages so Astro never auto-routes it, and astro.config.mjs only injects
 * the /curate route when the command is `dev`. It cannot ship.
 *
 * One idea: every piece is a card, and where the card sits is what it is.
 * Columns are the categories plus Archive. Drag a card to a column to move it,
 * drop a card onto another to combine them, and expand a combined card to
 * rearrange or pull pieces back out.
 *
 * Highlights is the one column that does not own its cards — a piece there is
 * also still in its category. That is the only exception to "where it sits is
 * what it is", so it sits apart, on the left.
 *
 * Everything it writes is an override in curation.ts. work.ts is never
 * touched, so every move is reversible.
 */
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { catalogue, coverOf, explodeItem, isDocSlide, isImageSlide } from '../data/work';
import type { WorkItem } from '../data/work';
import { highlights, featured, hidden, merges, moves, splits } from '../data/curation';
import { categories } from '../data/site';
import '../styles/global.css';

/** A width the site already generates, so these are cache hits. */
const sized = async (src: ImageMetadata, width: number) =>
  src.format === 'gif' || src.format === 'svg'
    ? src.src
    : (await getImage({ src, width, format: 'webp', quality: 72 })).src;

/** Every still in a piece, so a card can show what is inside it. */
function stillsOf(item: WorkItem): { src: ImageMetadata; caption: string }[] {
  if (item.kind === 'image') return [{ src: item.src, caption: item.caption }];
  if (item.kind !== 'carousel') return [{ src: item.poster, caption: item.caption }];
  const out: { src: ImageMetadata; caption: string }[] = [];
  for (const slide of item.slides) {
    if (isImageSlide(slide)) out.push({ src: slide.src, caption: slide.caption });
    else if (isDocSlide(slide)) {
      slide.doc.forEach((page, i) =>
        out.push({ src: page, caption: `${slide.caption} — page ${i + 1}` }),
      );
    }
  }
  return out.length ? out : [{ src: coverOf(item), caption: item.caption }];
}

/**
 * What a card is, in one word. A carousel holding more than one kind of thing
 * gets no label, because there is no single true answer for it — better silent
 * than wrong.
 */
function typeOf(item: WorkItem): string | null {
  if (item.kind === 'video') return 'Video';
  if (item.kind === 'embed') return item.embed.includes('soundcloud') ? 'Audio' : 'Video';
  if (item.kind === 'image') return 'Image';
  const kinds = new Set(
    item.slides.map((s) => ('model' in s ? '3D' : isDocSlide(s) ? 'Doc' : 'Image')),
  );
  return kinds.size === 1 ? [...kinds][0]! : null;
}

/**
 * Every piece the board can show: the catalogue, with any carousel that has
 * been split apart replaced by its parts.
 */
const split = new Set(splits);
const pieces: WorkItem[] = catalogue.flatMap((item: WorkItem) =>
  split.has(item.id) ? explodeItem(item) : [item],
);

const cards = await Promise.all(
  pieces.map(async (item) => ({
    id: item.id,
    title: item.title,
    category: item.category,
    kind: item.kind,
    thumb: await sized(coverOf(item), 400),
    slides: await Promise.all(
      stillsOf(item)
        .slice(0, 24)
        .map(async (s) => ({ src: await sized(s.src, 800), caption: s.caption })),
    ),
    count: item.kind === 'carousel' ? item.slides.length : 1,
    type: typeOf(item),
    /** An authored carousel can be split; a single still has nothing inside. */
    splittable: item.kind === 'carousel' && !item.id.includes('--'),
    /** Players cannot become carousel slides, so they cannot be combined. */
    combinable: item.kind === 'image' || item.kind === 'carousel',
  })),
);

const columns = [...categories.map((c) => ({ id: c.id, label: c.label }))];
const state = { highlights, featured, hidden, merges, moves, splits, cards, columns };
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Curate — local only</title>
    <style>
      /* The board fills the window; only the columns scroll. */
      html,
      body {
        height: 100%;
        overflow: hidden;
      }
      .col-body::-webkit-scrollbar,
      #board::-webkit-scrollbar {
        height: 10px;
        width: 10px;
      }
      .col-body::-webkit-scrollbar-thumb,
      #board::-webkit-scrollbar-thumb {
        border-radius: 999px;
        background: #d3d8db;
      }
    </style>
  </head>
  <body class="flex flex-col bg-page text-ink">
    <header class="flex shrink-0 flex-wrap items-center gap-3 border-b border-line px-5 py-3">
      <p class="font-heading text-[20px] font-medium tracking-[-0.02em]">Curate</p>
      <input
        id="search"
        type="search"
        placeholder="Search…"
        class="w-[220px] rounded-full border border-line bg-card px-4 py-2 text-[13px] outline-none focus:border-ink"
      />
      <span class="mr-auto text-[12px] opacity-55">
        Drag to a column to move · drop <b>onto</b> a card to combine · <b>⌘-click</b> to
        pick several · <b>⤢</b> opens a set
      </span>
      <span id="dirty" class="label-caps rounded-full px-3 py-1 text-[10px] opacity-55">
        saved
      </span>
      <button
        type="button"
        id="undo"
        class="label-caps cursor-pointer rounded-full border border-line px-4 py-2 transition-colors hover:bg-pill disabled:opacity-35"
      >
        Undo
      </button>
      <button
        type="button"
        id="publish"
        class="label-caps cursor-pointer rounded-full bg-ink px-5 py-2 text-card transition-opacity hover:opacity-80 disabled:opacity-40"
      >
        Publish
      </button>
      <span id="status" class="label-caps opacity-0 transition-opacity"></span>
    </header>

    <div
      id="restored"
      hidden
      class="flex shrink-0 items-center gap-3 border-b border-line bg-pill px-5 py-2 text-[12px]"
    >
      <span id="restored-msg"></span>
      <button
        type="button"
        id="discard"
        class="label-caps cursor-pointer rounded-full border border-line bg-card px-3 py-1"
      >
        Discard
      </button>
    </div>

    <div id="board" class="flex min-h-0 flex-1 gap-3 overflow-x-auto p-3"></div>

    {/* Inside a combined card. */}
    <div id="inspect" hidden class="fixed inset-0 z-40 flex flex-col bg-ink/92 backdrop-blur-xl">
      <div class="flex shrink-0 items-center gap-3 px-5 py-3 text-card">
        <p id="i-title" class="font-heading text-[18px] font-medium"></p>
        <span id="i-note" class="label-caps opacity-55"></span>
        <span class="mr-auto"></span>
        <button
          type="button"
          id="i-split"
          class="label-caps cursor-pointer rounded-full border border-card/30 px-4 py-2 hover:bg-card/15"
        >
          Split apart
        </button>
        <button
          type="button"
          id="i-close"
          class="label-caps cursor-pointer rounded-full px-3 py-2 opacity-70 hover:opacity-100"
        >
          Done
        </button>
      </div>
      <div class="min-h-0 flex-1 overflow-y-auto px-5 pb-6">
        <div
          id="i-box"
          class="mx-auto flex max-w-[1100px] flex-wrap gap-3 rounded-[18px] border-2 border-dashed border-card/35 p-4"
        >
        </div>
        <p class="mx-auto mt-3 max-w-[1100px] text-[12px] text-card/55">
          Drag to reorder inside the box, or drag a piece down to take it out of the set or
          archive it.
        </p>
        <div class="mx-auto mt-3 flex max-w-[1100px] gap-3">
          <div
            id="i-out"
            class="flex min-h-[92px] flex-1 flex-wrap items-center justify-center gap-3 rounded-[18px] border-2 border-dashed border-card/20 p-4"
          >
            <span class="text-[12px] text-card/45">drop here to take it out of the set</span>
          </div>
          <div
            id="i-archive"
            class="flex min-h-[92px] flex-1 flex-wrap items-center justify-center gap-3 rounded-[18px] border-2 border-dashed border-card/20 p-4"
          >
            <span class="text-[12px] text-card/45">drop here to archive it</span>
          </div>
        </div>
      </div>
    </div>

    <script is:inline set:html={`window.__CURATE__ = ${JSON.stringify(state)};`} />
    <script src="./curate.ts"></script>
  </body>
</html>
