---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { site } from '../data/site';

/**
 * Intro: the Eager Eyes logotype and two illustrations over Eager Eyes red,
 * landing on the name.
 *
 * Driven entirely by CSS keyframes rather than JS, so it still plays and still
 * clears itself if the script fails. JS only removes the node afterwards.
 */
const logos = import.meta.glob<{ default: ImageMetadata }>('../assets/loader/*.png', {
  eager: true,
});

// Fixed order — the sequence should read as a deliberate reel, not glob order.
const ORDER = ['eager-eyes', 'airpods', 'johnny-wheel'];
const marks = ORDER.flatMap((name) => {
  const mod = logos[`../assets/loader/${name}.png`];
  return mod ? [{ name, src: mod.default }] : [];
});

// Three marks rather than six, each given about twice as long — the old reel
// flicked past too fast to read any of them. HOLD stays a little longer than
// STEP so they cross-fade briefly instead of cutting.
const STEP = 0.62; // seconds between marks
const HOLD = 0.74; // how long each mark is on screen
const nameAt = (marks.length - 1) * STEP + HOLD - 0.12;
const outAt = nameAt + 0.95; // the name gets a beat of its own before the lift
---

<div id="loader" aria-hidden="true" style={`--out-at:${outAt}s`}>
  <div class="loader-stage">
    {
      marks.map((mark, i) => (
        <Image
          src={mark.src}
          alt=""
          widths={[520]}
          loading="eager"
          class="loader-mark"
          style={`animation-delay:${(i * STEP).toFixed(2)}s`}
        />
      ))
    }
    <span class="loader-name" style={`animation-delay:${nameAt.toFixed(2)}s`}>
      {site.name}
    </span>
  </div>
</div>

<style define:vars={{ hold: `${HOLD}s` }}>
  #loader {
    position: fixed;
    /* Full bleed — the frame sits above and masks it to the rounded window. */
    inset: 0;
    z-index: 50;
    display: grid;
    place-items: center;
    background: #ff3e3e;
    animation: loader-out 0.72s cubic-bezier(0.72, 0, 0.24, 1) var(--out-at) forwards;
    will-change: transform;
  }

  .loader-stage {
    display: grid;
    place-items: center;
    width: min(72vw, 420px);
    height: min(72vw, 420px);
  }

  /* Every mark and the name share one grid cell so they cross-fade in place. */
  .loader-stage > * {
    grid-area: 1 / 1;
    opacity: 0;
  }

  .loader-mark {
    width: 100%;
    height: auto;
    max-height: 100%;
    object-fit: contain;
    animation: mark-flash var(--hold) ease forwards;
  }

  .loader-name {
    font-family: var(--font-heading);
    font-size: clamp(40px, 9vw, 80px);
    font-weight: 500;
    letter-spacing: -0.04em;
    color: #fff;
    white-space: nowrap;
    animation: name-in 0.7s cubic-bezier(0.22, 0.61, 0.36, 1) forwards;
  }

  /* Longer holds mean the ease matters: fade up quickly, sit still, then leave. */
  @keyframes mark-flash {
    0% { opacity: 0; transform: scale(0.97); }
    14% { opacity: 1; transform: none; }
    80% { opacity: 1; transform: none; }
    100% { opacity: 0; transform: scale(1.02); }
  }

  @keyframes name-in {
    0% { opacity: 0; transform: translateY(12px); }
    100% { opacity: 1; transform: none; }
  }

  /* The panel lifts off rather than dissolving — the name rides up with it and
     the grid is revealed underneath, which reads as a curtain instead of a
     cross-fade. Ends off-viewport, so it cannot cover anything even if the
     script never removes it. */
  @keyframes loader-out {
    to { transform: translateY(-100%); }
  }

  /* No flashing sequence for anyone who asked not to see motion. */
  @media (prefers-reduced-motion: reduce) {
    #loader { display: none; }
  }
</style>

<script>
  const loader = document.getElementById('loader');
  if (loader) {
    // Astro scopes this component's <style>, which rewrites @keyframes names —
    // so match on the element, not the animation name. Child marks animate too,
    // but those events target the mark, not the loader.
    const done = () => {
      if (!loader.isConnected) return;
      loader.remove();
      document.dispatchEvent(new CustomEvent('loader:done'));
    };
    loader.addEventListener('animationend', (e) => {
      if (e.target === loader) done();
    });
    // Belt and braces: if the animation never fires, don't strand the page.
    setTimeout(done, 6000);
  }
</script>
