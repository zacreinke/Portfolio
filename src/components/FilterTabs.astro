---
import { categories } from '../data/site';

const tabs = [{ id: 'all', label: 'All Work' }, ...categories];
---

<div class="mx-auto max-w-site px-5 sm:px-8">
  <div class="relative">
    <div
      id="tabs"
      role="tablist"
      aria-label="Filter work by type"
      class="no-scrollbar flex gap-7 overflow-x-auto overflow-y-hidden border-b border-line"
    >
      {
        tabs.map((tab, i) => (
          <button
            type="button"
            role="tab"
            id={`tab-${tab.id}`}
            data-filter={tab.id}
            aria-selected={i === 0 ? 'true' : 'false'}
            aria-controls="work"
            tabindex={i === 0 ? 0 : -1}
            class="label-caps shrink-0 cursor-pointer border-b border-transparent px-0.5 pt-1 pb-1 whitespace-nowrap opacity-55 transition-opacity duration-200 hover:opacity-100 aria-selected:border-ink aria-selected:opacity-100"
          >
            {tab.label}
          </button>
        ))
      }
    </div>

    {/* Fades in only when the row actually overflows, and out again at the end
        of the scroll — the only cue that there is more to reach. */}
    <div
      id="tabs-fade"
      aria-hidden="true"
      class="pointer-events-none absolute top-0 right-0 bottom-px w-20 bg-gradient-to-r from-transparent to-page opacity-0 transition-opacity duration-200"
    >
    </div>
  </div>
</div>
