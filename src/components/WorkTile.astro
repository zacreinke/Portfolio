---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { coverOf, isDocSlide, isImageSlide, nameOf, type WorkItem } from '../data/work';
import { transparent } from '../data/transparent';

interface Props {
  item: WorkItem;
  /** Index of this item's first slide in the flat lightbox sequence. */
  index: number;
  eager?: boolean;
}

const { item, index, eager = false } = Astro.props;

const cover: ImageMetadata = coverOf(item);

const slideCount = item.kind === 'carousel' ? item.slides.length : 1;
const isPlayable = item.kind === 'video' || item.kind === 'embed';

/**
 * What the tile is, said on the tile. A 3D model, a scrollable document and a
 * photo set were all showing a bare number, so the grid gave no clue what a
 * tile would open into.
 *
 * A medium only earns the label when the whole set is that medium — a carousel
 * of stills that happens to end on a PDF is not a document, and calling it
 * "DOC" describes one slide out of ten.
 */
const marker = (() => {
  // 3D pieces are a render plus the model, so they are mixed by construction —
  // but the category is never wrong about them, and a bare count tells you less
  // than nothing about a tile you can spin.
  if (item.category === '3d') return '3D';
  if (item.kind === 'carousel' && item.slides.every(isDocSlide)) return 'DOC';
  if (item.kind === 'embed' && item.embed.includes('soundcloud')) return 'Audio';
  if (slideCount > 1) return String(slideCount);
  return null;
})();
/** Counts stay in the fixed circle; words need a pill that can grow. */
const markerIsCount = marker !== null && /^\d+$/.test(marker);

/**
 * Tiles take their cover's shape, but an unbounded shape wrecks the grid: a
 * 0.41 display ad becomes a tower and a 4.27 lockup becomes a letter slot.
 * Clamp the frame, and where the clamp bites, letterbox the artwork inside it
 * rather than cropping — a beheaded guitar is worse than empty margin.
 *
 * The floor sits just under the portrait illustrations (0.5625) so those fill
 * their frame edge to edge; only the genuine outliers get letterboxed.
 */
const MIN_RATIO = 0.55; // ~5:9, the tallest a tile may stand
const MAX_RATIO = 2.0; // 2:1, the widest it may lie
const trueRatio = cover.width / cover.height;
const ratio = Math.min(MAX_RATIO, Math.max(MIN_RATIO, trueRatio));
const clamped = Math.abs(ratio - trueRatio) > 0.001;

/**
 * A mark delivered on transparency has no ground of its own. The tile is
 * already white, so it only needs to stop bleeding into the edges: contain it
 * and give it margin. Checked across every slide, since any of them can rotate
 * into view and they all share the cover's treatment.
 */
const hasTransparent =
  transparent.has(nameOf(cover) ?? '') ||
  (item.kind === 'carousel' &&
    item.slides.some((s) => isImageSlide(s) && transparent.has(nameOf(s.src) ?? '')));

/** Letterbox rather than crop whenever cropping would lose part of the work. */
const contain = clamped || hasTransparent;

/** Two more slides peek out from behind the cover on hover, like a fanned deck. */
const fan =
  item.kind === 'carousel'
    ? item.slides.filter(isImageSlide).slice(1, 3).map((s) => s.src)
    : [];

// sharp would flatten an animated GIF to its first frame, so pass those
// (and SVGs) straight through instead of running them through <Image>.
const passthrough = cover.format === 'gif' || cover.format === 'svg';

// Absolutely positioned inside a ratio-locked box: a rotating carousel must not
// resize its frame, or every swap would reflow the whole masonry column.
// Padding insets the painted image because object-fit resolves against the
// content box, so a slide transform still travels the full tile width.
const mediaClass =
  'absolute inset-0 size-full transition-transform duration-500 ease-out ' +
  'group-hover:scale-[1.03] ' +
  (contain ? 'object-contain p-[7%] sm:p-[6%]' : 'object-cover');
---

<figure
  class="group reveal relative"
  data-tile
  data-index={index}
  data-category={item.category}
  data-ratio={ratio.toFixed(4)}
  data-span={item.wide ? 2 : 1}
  data-highlight={item.highlight ? '1' : undefined}
  hidden={!item.highlight}
>
  {
    fan.map((src, i) => (
      <Image
        src={src}
        alt=""
        aria-hidden="true"
        widths={[400]}
        loading="lazy"
        decoding="async"
        class={`fan fan-${i + 1} pointer-events-none absolute inset-0 size-full rounded-tile border border-line bg-card object-cover`}
      />
    ))
  }

  <button
    type="button"
    data-open
    aria-label={`Open ${item.title}`}
    class="relative block w-full cursor-pointer overflow-hidden rounded-tile border border-line bg-card"
  >
    <span class="relative block w-full" style={`aspect-ratio:${ratio.toFixed(4)}`} data-media>
    {
      passthrough ? (
        <img
          src={cover.src}
          alt={item.title}
          width={cover.width}
          height={cover.height}
          loading={eager ? 'eager' : 'lazy'}
          decoding="async"
          class={mediaClass}
        />
      ) : (
        <Image
          src={cover}
          alt={item.title}
          widths={[400, 800, 1200]}
          sizes="(min-width: 1280px) 300px, (min-width: 1024px) 32vw, (min-width: 640px) 48vw, 92vw"
          loading={eager ? 'eager' : 'lazy'}
          decoding="async"
          class={mediaClass}
        />
      )
    }
    </span>

    {
      isPlayable && (
        <span class="pointer-events-none absolute inset-0 flex items-center justify-center">
          <span class="flex size-12 items-center justify-center rounded-full bg-ink/30 text-card backdrop-blur-sm">
            <svg viewBox="0 0 24 24" class="ml-0.5 size-5" fill="currentColor" aria-hidden="true">
              <path d="M8 5v14l11-7z" />
            </svg>
          </span>
        </span>
      )
    }
  </button>

  {/* A count keeps the fixed circle, so 1 and 12 render at the same size;
      a medium label gets a pill of the same height that grows with the word. */}
  {
    marker && (
      <span
        class={
          'pointer-events-none absolute top-2.5 right-2.5 z-10 flex h-7 items-center justify-center rounded-full bg-ink/30 text-card backdrop-blur-sm ' +
          (markerIsCount
            ? 'w-7 text-[11px] font-semibold tabular-nums'
            : 'px-2.5 text-[10px] font-semibold tracking-[0.08em] uppercase')
        }
      >
        {marker}
      </span>
    )
  }
</figure>
