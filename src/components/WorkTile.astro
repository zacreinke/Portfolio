---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { WorkItem } from '../data/work';
import { categoryLabel } from '../data/site';
import { withBase } from '../lib/url';

interface Props {
  item: WorkItem;
  /** Index of this item's first slide in the flat lightbox sequence. */
  index: number;
  eager?: boolean;
}

const { item, index, eager = false } = Astro.props;

const cover: ImageMetadata =
  item.kind === 'carousel' ? item.slides[0]!.src : item.kind === 'image' ? item.src : item.poster;

const slideCount = item.kind === 'carousel' ? item.slides.length : 1;

// sharp would flatten an animated GIF to its first frame, so pass those
// (and SVGs) straight through instead of running them through <Image>.
const passthrough = cover.format === 'gif' || cover.format === 'svg';
---

<figure
  class="group"
  data-tile
  data-index={index}
  data-category={item.category}
>
  <button
    type="button"
    data-open={index}
    aria-label={`Open ${item.title}`}
    class="relative block w-full cursor-pointer overflow-hidden rounded-card border border-line bg-card"
  >
    {
      passthrough ? (
        <img
          src={cover.src}
          alt={item.title}
          width={cover.width}
          height={cover.height}
          loading={eager ? 'eager' : 'lazy'}
          decoding="async"
          class="block w-full transition-transform duration-500 ease-out group-hover:scale-[1.03]"
        />
      ) : (
        <Image
          src={cover}
          alt={item.title}
          widths={[400, 800, 1200]}
          sizes="(min-width: 1280px) 300px, (min-width: 1024px) 32vw, (min-width: 640px) 48vw, 92vw"
          loading={eager ? 'eager' : 'lazy'}
          decoding="async"
          class="block w-full transition-transform duration-500 ease-out group-hover:scale-[1.03]"
        />
      )
    }

    {
      item.kind === 'video' && (
        <video
          src={withBase(item.src)}
          muted
          loop
          playsinline
          preload="none"
          data-hover-video
          class="pointer-events-none absolute inset-0 size-full object-cover opacity-0 transition-opacity duration-300 group-hover:opacity-100"
        />
      )
    }

    {/* Media-kind affordance: slide count for carousels, a play glyph for video. */}
    {
      slideCount > 1 && (
        <span class="label-caps absolute top-2.5 right-2.5 rounded-full bg-card/90 px-2.5 py-1 text-[10px] backdrop-blur-sm">
          {slideCount}
        </span>
      )
    }
    {
      (item.kind === 'video' || item.kind === 'embed') && (
        <span class="pointer-events-none absolute inset-0 flex items-center justify-center">
          <span class="flex size-12 items-center justify-center rounded-full bg-card/90 backdrop-blur-sm">
            <svg viewBox="0 0 24 24" class="ml-0.5 size-5" fill="currentColor" aria-hidden="true">
              <path d="M8 5v14l11-7z"></path>
            </svg>
          </span>
        </span>
      )
    }
  </button>

  <figcaption class="mt-2.5 flex items-baseline justify-between gap-3 px-0.5">
    <span class="font-heading text-[15px] font-medium tracking-[-0.015em]">{item.title}</span>
    <span class="label-caps shrink-0 text-[10px] opacity-60">{categoryLabel(item.category)}</span>
  </figcaption>
</figure>
