---
import { Image } from 'astro:assets';
import zac from '../assets/zac.webp';
import { site } from '../data/site';
import { withBase } from '../lib/url';

interface Props {
  current?: 'work' | 'about';
}

const { current = 'work' } = Astro.props;

/**
 * Scrolls away with the page. It is tall enough at full width that pinning it
 * cost more room than it bought.
 *
 * The portrait and the button track the frame's corner radius: the frame eases
 * 48 -> 32 -> 24px as the viewport narrows, and a 64px portrait beside a 24px
 * corner reads as oversized.
 */
---

<header class="bg-page">
  <nav
    class="mx-auto flex max-w-[1728px] flex-wrap items-center justify-between gap-x-4 gap-y-3 pt-6 pr-6 pb-4 pl-6 sm:gap-x-8"
    aria-label="Primary"
  >
    <a href={`${withBase('')}#work`} class="flex items-center gap-3 sm:gap-4">
      <Image
        src={zac}
        alt={site.name}
        width={128}
        height={128}
        densities={[1, 2]}
        loading="eager"
        class="size-10 rounded-full object-cover sm:size-[52px] lg:size-16"
      />
      <span
        class="font-heading font-medium tracking-[-0.025em] whitespace-nowrap text-[22px] sm:text-[26px] lg:text-[32px]"
      >
        {site.name}
      </span>
    </a>

    <div class="order-last flex w-full items-center justify-center gap-6 sm:order-none sm:ml-auto sm:w-auto sm:gap-8">
      <a
        href={`${withBase('')}#work`}
        aria-current={current === 'work' ? 'page' : undefined}
        class:list={[
          'label-caps inline-flex min-h-11 items-center transition-opacity duration-200 hover:opacity-100',
          current === 'work' ? 'underline underline-offset-4' : 'opacity-60',
        ]}
      >Work</a>
      <a
        href={withBase('about/')}
        aria-current={current === 'about' ? 'page' : undefined}
        class:list={[
          'label-caps inline-flex min-h-11 items-center transition-opacity duration-200 hover:opacity-100',
          current === 'about' ? 'underline underline-offset-4' : 'opacity-60',
        ]}
      >About</a>
    </div>

    <a
      href={`mailto:${site.email}?subject=Let%27s%20work%20together`}
      target="_blank"
      rel="noopener noreferrer"
      class="label-caps inline-flex h-10 shrink-0 items-center rounded-full bg-ink px-3 text-card whitespace-nowrap transition-opacity duration-200 hover:opacity-80 min-[360px]:px-5 sm:h-[52px] sm:px-6 lg:h-16 lg:px-8"
    >
      Hit Me Up!
    </a>
  </nav>
</header>
