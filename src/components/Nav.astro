---
import { Image } from 'astro:assets';
import zac from '../assets/zac.webp';
import { site } from '../data/site';
---

<header>
  <nav
    class="mx-auto flex max-w-site items-center justify-between gap-4 px-5 py-5 sm:px-8"
    aria-label="Primary"
  >
    <a href="#work" class="flex items-center gap-3">
      <Image
        src={zac}
        alt={site.name}
        width={80}
        height={80}
        densities={[1, 2]}
        loading="eager"
        class="size-10 rounded-full object-cover"
      />
      <span class="font-heading text-[24px] font-medium tracking-[-0.025em] whitespace-nowrap">
        {site.name}
      </span>
    </a>

    <a
      href={`mailto:${site.email}?subject=Let%27s%20work%20together`}
      target="_blank"
      rel="noopener noreferrer"
      class="label-caps rounded-full bg-ink px-5 py-2.5 text-card whitespace-nowrap transition-opacity duration-200 hover:opacity-80"
    >
      Hit Me Up!
    </a>
  </nav>
</header>
