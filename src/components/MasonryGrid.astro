---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import WorkTile from './WorkTile.astro';
import { work } from '../data/work';
import { categories, categoryLabel } from '../data/site';
import { withBase } from '../lib/url';

/**
 * Every viewable frame, flattened into one linear sequence. Carousel slides sit
 * inline alongside single images, so the lightbox needs only one pair of arrows
 * — no nested controls.
 */
type Frame = {
  itemId: string;
  category: string;
  categoryLabel: string;
  title: string;
  caption: string;
  kind: 'image' | 'video' | 'embed';
  /** Full-size source for the lightbox. */
  src: string;
  width: number;
  height: number;
  /** 1-based position within the parent item, and how many it has. */
  slide: number;
  slides: number;
  ratio?: number;
};

/** Animated GIFs and SVGs are passed through untouched; sharp would flatten them. */
async function sized(src: ImageMetadata, width: number) {
  if (src.format === 'gif' || src.format === 'svg') {
    return { url: src.src, width: src.width, height: src.height };
  }
  const out = await getImage({
    src,
    width: Math.min(src.width, width),
    format: 'webp',
    quality: 82,
  });
  return {
    url: out.src,
    width: out.attributes.width ?? src.width,
    height: out.attributes.height ?? src.height,
  };
}

const frames: Frame[] = [];
const tiles: { item: (typeof work)[number]; index: number }[] = [];

for (const item of work) {
  tiles.push({ item, index: frames.length });

  const shared = {
    itemId: item.id,
    category: item.category,
    categoryLabel: categoryLabel(item.category),
    title: item.title,
  };

  if (item.kind === 'carousel') {
    const total = item.slides.length;
    for (const [i, slide] of item.slides.entries()) {
      const full = await sized(slide.src, 1600);
      frames.push({
        ...shared,
        caption: slide.caption || item.caption,
        kind: 'image',
        src: full.url,
        width: full.width,
        height: full.height,
        slide: i + 1,
        slides: total,
      });
    }
  } else if (item.kind === 'image') {
    const full = await sized(item.src, 1600);
    frames.push({
      ...shared,
      caption: item.caption,
      kind: 'image',
      src: full.url,
      width: full.width,
      height: full.height,
      slide: 1,
      slides: 1,
    });
  } else if (item.kind === 'video') {
    frames.push({
      ...shared,
      caption: item.caption,
      kind: 'video',
      src: withBase(item.src),
      width: item.poster.width,
      height: item.poster.height,
      slide: 1,
      slides: 1,
    });
  } else {
    frames.push({
      ...shared,
      caption: item.caption,
      kind: 'embed',
      src: item.embed,
      width: item.poster.width,
      height: item.poster.height,
      slide: 1,
      slides: 1,
      ratio: item.ratio ?? 16 / 9,
    });
  }
}

const emptyCategories = categories
  .filter((c) => !work.some((w) => w.category === c.id))
  .map((c) => c.id);
---

<section id="work" class="mx-auto max-w-site px-5 pt-4 sm:px-8" aria-live="polite">
  <div class="masonry">
    {tiles.map(({ item, index }, i) => <WorkTile item={item} index={index} eager={i < 8} />)}
  </div>

  {
    categories.map((c) => (
      <p data-empty={c.id} hidden class="py-24 text-center text-[15px] opacity-55">
        More {c.label.toLowerCase()} coming soon.
      </p>
    ))
  }
</section>

<script
  is:inline
  id="frames"
  type="application/json"
  set:html={JSON.stringify({ frames, emptyCategories })}
/>
