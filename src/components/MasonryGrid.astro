---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import WorkTile from './WorkTile.astro';
import { work, isImageSlide, isDocSlide, coverOf } from '../data/work';
import { categories, categoryLabel } from '../data/site';
import { withBase } from '../lib/url';

/**
 * Every viewable frame, flattened into one linear sequence. Carousel slides sit
 * inline alongside single images, so the lightbox needs only one pair of arrows
 * — no nested controls.
 */
type Frame = {
  itemId: string;
  category: string;
  categoryLabel: string;
  title: string;
  caption: string;
  kind: 'image' | 'video' | 'embed' | 'model' | 'doc';
  /** Part of the curated Highlights view. */
  highlight: boolean;
  /** Full-size source for the lightbox. */
  src: string;
  /** Tile-size source, used when a carousel rotates in the grid. */
  thumb?: string;
  /** Square-ish source for the lightbox thumbnail strip. */
  chip: string;
  width: number;
  height: number;
  /** 1-based position within the parent item, and how many it has. */
  slide: number;
  slides: number;
  ratio?: number;
  /** Selectable bodies for a model frame; one entry means no dropdown. */
  parts?: { label: string; src: string }[];
  /** Pages of a document frame, stacked and scrolled rather than paged. */
  pages?: { src: string; width: number; height: number }[];
};

/** Animated GIFs and SVGs are passed through untouched; sharp would flatten them. */
async function sized(src: ImageMetadata, width: number) {
  if (src.format === 'gif' || src.format === 'svg') {
    return { url: src.src, width: src.width, height: src.height };
  }
  const out = await getImage({
    src,
    width: Math.min(src.width, width),
    format: 'webp',
    quality: 82,
  });
  return {
    url: out.src,
    width: out.attributes.width ?? src.width,
    height: out.attributes.height ?? src.height,
  };
}

const frames: Frame[] = [];
const tiles: { item: (typeof work)[number]; index: number }[] = [];

/**
 * work.ts is grouped by category so it stays readable, but rendering in that
 * order makes "All Work" read as six blocks. Round-robin across the categories
 * instead, so every screenful mixes disciplines. Filtering preserves relative
 * order, so the single-category views are unaffected.
 */
const byCategory = categories.map((c) => work.filter((w) => w.category === c.id));
const interleaved: typeof work = [];
for (let i = 0; interleaved.length < work.length; i++) {
  for (const bucket of byCategory) {
    if (bucket[i]) interleaved.push(bucket[i]!);
  }
}

for (const item of interleaved) {
  tiles.push({ item, index: frames.length });

  const itemChip = (await sized(coverOf(item), 200)).url;

  const shared = {
    itemId: item.id,
    category: item.category,
    categoryLabel: categoryLabel(item.category),
    title: item.title,
    highlight: item.highlight === true,
  };

  if (item.kind === 'carousel') {
    const total = item.slides.length;
    for (const [i, slide] of item.slides.entries()) {
      if (isDocSlide(slide)) {
        const pages = [];
        for (const page of slide.doc) pages.push(await sized(page, 1400));
        frames.push({
          ...shared,
          caption: slide.caption || item.caption,
          kind: 'doc',
          chip: (await sized(slide.doc[0]!, 200)).url,
          src: pages[0]!.url,
          width: pages[0]!.width,
          height: pages[0]!.height,
          slide: i + 1,
          slides: total,
          pages: pages.map((pg) => ({ src: pg.url, width: pg.width, height: pg.height })),
        });
        continue;
      }
      if (!isImageSlide(slide)) {
        const parts = (
          typeof slide.model === 'string'
            ? [{ label: 'Model', file: slide.model }]
            : slide.model
        ).map((part) => ({ label: part.label, src: withBase(`models/${part.file}`) }));
        frames.push({
          ...shared,
          caption: slide.caption || item.caption,
          kind: 'model',
          chip: itemChip,
          src: parts[0]!.src,
          width: 1,
          height: 1,
          slide: i + 1,
          slides: total,
          parts,
        });
        continue;
      }
      const full = await sized(slide.src, 1600);
      const thumb = await sized(slide.src, 800);
      frames.push({
        ...shared,
        caption: slide.caption || item.caption,
        kind: 'image',
        chip: (await sized(slide.src, 200)).url,
        src: full.url,
        thumb: thumb.url,
        width: full.width,
        height: full.height,
        slide: i + 1,
        slides: total,
      });
    }
  } else if (item.kind === 'image') {
    const full = await sized(item.src, 1600);
    frames.push({
      ...shared,
      caption: item.caption,
      kind: 'image',
      chip: itemChip,
      src: full.url,
      width: full.width,
      height: full.height,
      slide: 1,
      slides: 1,
    });
  } else if (item.kind === 'video') {
    frames.push({
      ...shared,
      caption: item.caption,
      kind: 'video',
      chip: itemChip,
      src: withBase(item.src),
      width: item.poster.width,
      height: item.poster.height,
      slide: 1,
      slides: 1,
    });
  } else {
    frames.push({
      ...shared,
      caption: item.caption,
      kind: 'embed',
      chip: itemChip,
      src: item.embed,
      width: item.poster.width,
      height: item.poster.height,
      slide: 1,
      slides: 1,
      ratio: item.ratio ?? 16 / 9,
    });
  }
}

const emptyCategories = categories
  .filter((c) => !work.some((w) => w.category === c.id))
  .map((c) => c.id);
---

<section id="work" class="mx-auto max-w-site px-5 pt-4 sm:px-8" aria-live="polite">
  <div class="masonry">
    {tiles.map(({ item, index }, i) => <WorkTile item={item} index={index} eager={i < 8} />)}
  </div>

  {
    categories.map((c) => (
      <p data-empty={c.id} hidden class="py-24 text-center text-[15px] opacity-55">
        More {c.label.toLowerCase()} coming soon.
      </p>
    ))
  }
</section>

<script
  is:inline
  id="frames"
  type="application/json"
  set:html={JSON.stringify({ frames, emptyCategories })}
/>
